root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,sln,slnf,razor,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,razor}]
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[*.py]
max_line_length = 100

[*.{cmd,bat,ps1}]
end_of_line = crlf

[tests/**.cs]
# Nomes de teste descritivos usam sublinhado.
dotnet_diagnostic.CA1707.severity = none

[**/Migrations/*.cs]
# Código gerado pelo EF Core: fora da análise de estilo.
generated_code = true
