@page "/admin"
@inherits PaginaProtegida

<h1>Painel de acesso</h1>

@if (!Autenticado)
{
    <p class="vazio">Carregando...</p>
}
else if (_usuarios is null)
{
    <p class="@(_erroDaLista is null ? "vazio" : "aviso erro")" role="@(_erroDaLista is null ? null : "alert")">@(_erroDaLista ?? "Carregando...")</p>
}
else
{
    <div class="resumo">
        <div class="c-agua"><strong>@_usuarios.Count(u => u.Nivel == 1)</strong><span>servidores (nível 1)</span></div>
        <div class="c-folha"><strong>@_usuarios.Count(u => u.Nivel == 2)</strong><span>diretores (nível 2)</span></div>
        <div class="c-terra"><strong>@_usuarios.Count(u => u.Nivel == 3)</strong><span>ministros (nível 3)</span></div>
        <div class="c-erro"><strong>@_usuarios.Count(u => u.Admin)</strong><span>administradores</span></div>
    </div>
    <p class="rotulo">Mude o nível de acesso, quem é administrador, exclua cadastros e escolha o processamento do rosto. Cada ação pede o seu rosto e fica no relatório.</p>

    @if (_aviso is not null)
    {
        <p class="aviso ok" role="status">@_aviso</p>
    }

    @if (_editando is not null)
    {
        <section class="cartao largo">
            <h2>@(_excluindo ? $"Excluir {_editando.Nome}" : _editando.Nome)</h2>
            @if (_excluindo)
            {
                <p>O cadastro, o vetor do rosto e as sessões de <strong>@_editando.Nome</strong> serão apagados e não voltam. O histórico de acessos fica no relatório, sem o vínculo com a pessoa.</p>
                <Confirmacao Texto="Mostre o seu rosto para confirmar a exclusão."
                             SoRosto="true"
                             PermiteRosto="true"
                             Ocupado="_ocupado"
                             Erro="@_erro"
                             OnConfirmar="ExcluirAsync"
                             OnCancelar="Cancelar" />
            }
            else if (!_confirmando)
            {
                <label>Nível de acesso
                    <select @bind="_nivel">
                        <option value="1">1: Servidor</option>
                        <option value="2">2: Diretor de divisão</option>
                        <option value="3">3: Ministro do Meio Ambiente</option>
                    </select>
                </label>
                <label class="marcar">
                    <input type="checkbox" @bind="_admin" disabled="@(_editando.AdminFixo || (_editando.EhVoce && _editando.Admin))" />
                    <span>Administrador (abre este painel)@(_editando.AdminFixo ? ". Definido na configuração do servidor, não dá para tirar." : _editando.EhVoce && _editando.Admin ? ". Você não pode tirar o seu próprio perfil." : "")</span>
                </label>
                @if (_erro is not null)
                {
                    <p class="aviso erro" role="alert">@_erro</p>
                }
                <div class="acoes">
                    <button type="button" @onclick="Continuar">Continuar</button>
                    <button type="button" class="secundario" @onclick="Cancelar">Cancelar</button>
                </div>
            }
            else
            {
                <Confirmacao Texto="Mostre o rosto para confirmar a mudança."
                             SoRosto="true"
                             PermiteRosto="true"
                             Ocupado="_ocupado"
                             Erro="@_erro"
                             OnConfirmar="ConfirmarAsync"
                             OnCancelar="Cancelar" />
            }
        </section>
    }

    <label>Buscar por nome
        <input @bind="_filtro" @bind:event="oninput" placeholder="Nome" autocomplete="off" />
    </label>

    <div class="painel-tabela">
        <div class="tabela">
            <table>
                <thead>
                    <tr><th>Pessoa</th><th>CPF</th><th>Nível</th><th>Admin</th><th>Rosto</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Filtrados())
                    {
                        <tr>
                            <td>
                                <div class="pessoa">
                                    <span class="avatar" aria-hidden="true">@Iniciais(u.Nome)</span>
                                    <span>@u.Nome@(u.EhVoce ? " (você)" : "")</span>
                                </div>
                            </td>
                            <td>@u.CpfMascarado</td>
                            <td><span class="selo n@(u.Nivel)">@u.Nivel: @u.Cargo</span></td>
                            <td>@if (u.Admin) { <span class="selo admin">@(u.AdminFixo ? "Admin fixo" : "Admin")</span> } else { <span class="rotulo">-</span> }</td>
                            <td><span class="selo @(u.TemRosto ? "" : "alerta")">@(u.TemRosto ? "Cadastrado" : "Sem rosto")</span></td>
                            <td>
                                <div class="acoes">
                                    @if (u.Status == "ATIVO")
                                    {
                                        <button type="button" class="secundario" disabled="@_ocupado" @onclick="() => Editar(u)">Alterar</button>
                                    }
                                    else
                                    {
                                        <span class="rotulo">cadastro pendente</span>
                                    }
                                    @if (!u.EhVoce && !u.AdminFixo)
                                    {
                                        <button type="button" class="perigo" disabled="@_ocupado" @onclick="() => PedirExclusao(u)">Excluir</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="rodape-tabela">@Filtrados().Count() de @_usuarios.Count cadastrados.</div>
    </div>
    @if (!Filtrados().Any())
    {
        <p class="vazio">Ninguém encontrado.</p>
    }

    <section class="cartao largo">
        <h2>Processamento do rosto</h2>
        <p class="rotulo">Como o serviço de reconhecimento prepara a foto antes de procurar o rosto. Vale para todos os cadastros e entradas.</p>
        @if (_processamento is null)
        {
            <p class="@(_erroDoProcessamento is null ? "vazio" : "aviso erro")">@(_erroDoProcessamento ?? "Carregando...")</p>
        }
        else if (!_confirmandoProcessamento)
        {
            <div class="filtros">
                <label>Pré-processamento
                    <select @bind="_pre">
                        @foreach (var p in _processamento.PreProcessamentos)
                        {
                            <option value="@p">@RotuloDoPre(p)</option>
                        }
                    </select>
                </label>
                <label>Tratamento de ruído
                    <select @bind="_ruido">
                        @foreach (var r in _processamento.TratamentosDeRuido)
                        {
                            <option value="@r">@RotuloDoRuido(r)</option>
                        }
                    </select>
                </label>
            </div>
            <p class="aviso alerta">Os rostos já cadastrados foram lidos com o método antigo. Se mudar, teste a entrada de quem já está cadastrado e refaça o rosto de quem deixar de ser reconhecido.</p>
            @if (_erroDoProcessamento is not null)
            {
                <p class="aviso erro" role="alert">@_erroDoProcessamento</p>
            }
            <div class="acoes">
                <button type="button" disabled="@(_ocupado || (_pre == _processamento.PreProcessamento && _ruido == _processamento.TratamentoRuido))" @onclick="ContinuarProcessamento">Salvar</button>
                <span class="rotulo">Em uso: @RotuloDoPre(_processamento.PreProcessamento), ruído: @RotuloDoRuido(_processamento.TratamentoRuido)@(_processamento.AtualizadoEm is { } quando ? $" (desde {Formato.DataHora(quando)})" : "")</span>
            </div>
        }
        else
        {
            <Confirmacao Texto="Mostre o seu rosto para confirmar a mudança do processamento."
                         SoRosto="true"
                         PermiteRosto="true"
                         Ocupado="_ocupado"
                         Erro="@_erroDoProcessamento"
                         OnConfirmar="SalvarProcessamentoAsync"
                         OnCancelar="CancelarProcessamento" />
        }
    </section>
}

@code {
    private List<UsuarioAdminDto>? _usuarios;
    private UsuarioAdminDto? _editando;
    private ProcessamentoDto? _processamento;
    private string _filtro = "";
    private int _nivel;
    private bool _admin;
    private bool _excluindo;
    private bool _confirmando;
    private bool _ocupado;
    private string _pre = "";
    private string _ruido = "";
    private bool _confirmandoProcessamento;
    private string? _erro;
    private string? _erroDaLista;
    private string? _erroDoProcessamento;
    private string? _aviso;

    protected override async Task CarregarAsync()
    {
        await RecarregarAsync();
        await RecarregarProcessamentoAsync();
    }

    private async Task RecarregarAsync()
    {
        var r = await Api.UsuariosAdminAsync();
        if (r.Ok)
        {
            _usuarios = r.Valor;
        }
        else
        {
            _erroDaLista = r.Erro!.Mensagem;
        }
    }

    private async Task RecarregarProcessamentoAsync()
    {
        var r = await Api.ProcessamentoAsync();
        if (r.Ok)
        {
            _processamento = r.Valor;
            (_pre, _ruido) = (r.Valor!.PreProcessamento, r.Valor.TratamentoRuido);
        }
        else
        {
            _erroDoProcessamento = r.Erro!.Mensagem;
        }
    }

    private static string Iniciais(string nome) =>
        string.Concat(nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private static string RotuloDoPre(string codigo) => codigo switch
    {
        "clahe" => "CLAHE (contraste adaptativo)",
        "equalizacao" => "Equalização de histograma",
        "gaussiano" => "Filtro gaussiano",
        _ => codigo,
    };

    private static string RotuloDoRuido(string codigo) => codigo switch
    {
        "nenhum" => "Nenhum (desligado)",
        "mediana" => "Filtro mediano",
        "abertura" => "Abertura morfológica",
        "fechamento" => "Fechamento morfológico",
        _ => codigo,
    };

    private IEnumerable<UsuarioAdminDto> Filtrados() =>
        (_usuarios ?? []).Where(u => string.IsNullOrWhiteSpace(_filtro) || u.Nome.Contains(_filtro.Trim(), StringComparison.CurrentCultureIgnoreCase));

    private void Editar(UsuarioAdminDto usuario)
    {
        _editando = usuario;
        (_nivel, _admin) = (usuario.Nivel, usuario.Admin);
        (_excluindo, _confirmando) = (false, false);
        _erro = null;
        _aviso = null;
    }

    private void PedirExclusao(UsuarioAdminDto usuario)
    {
        _editando = usuario;
        (_excluindo, _confirmando) = (true, false);
        _erro = null;
        _aviso = null;
    }

    private void Cancelar()
    {
        _editando = null;
        (_excluindo, _confirmando) = (false, false);
        _erro = null;
    }

    private void Continuar()
    {
        if (_nivel == _editando!.Nivel && _admin == _editando.Admin)
        {
            _erro = "Nada mudou.";
            return;
        }

        _erro = null;
        _confirmando = true;
    }

    private async Task ConfirmarAsync(Credencial credencial)
    {
        _ocupado = true;
        _erro = null;
        try
        {
            var alvo = _editando!;
            var r = await Api.AlterarAcessoAsync(alvo.Id, _nivel == alvo.Nivel ? null : _nivel, _admin == alvo.Admin ? null : _admin, credencial.Imagem!);
            if (r.Ok)
            {
                _aviso = $"Acesso de {alvo.Nome} atualizado.";
                Cancelar();
                await RecarregarAsync();
            }
            else
            {
                _erro = r.Erro!.Mensagem;
            }
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task ExcluirAsync(Credencial credencial)
    {
        _ocupado = true;
        _erro = null;
        try
        {
            var alvo = _editando!;
            var r = await Api.ExcluirCadastroAsync(alvo.Id, credencial.Imagem!);
            if (r.Ok)
            {
                _aviso = $"Cadastro de {alvo.Nome} excluído, com o vetor do rosto.";
                Cancelar();
                await RecarregarAsync();
            }
            else
            {
                _erro = r.Erro!.Mensagem;
            }
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void ContinuarProcessamento()
    {
        _erroDoProcessamento = null;
        _aviso = null;
        _confirmandoProcessamento = true;
    }

    private void CancelarProcessamento()
    {
        _confirmandoProcessamento = false;
        _erroDoProcessamento = null;
    }

    private async Task SalvarProcessamentoAsync(Credencial credencial)
    {
        _ocupado = true;
        _erroDoProcessamento = null;
        try
        {
            var r = await Api.AlterarProcessamentoAsync(_pre, _ruido, credencial.Imagem!);
            if (r.Ok)
            {
                _aviso = "Processamento do rosto atualizado.";
                _confirmandoProcessamento = false;
                await RecarregarProcessamentoAsync();
            }
            else
            {
                _erroDoProcessamento = r.Erro!.Mensagem;
            }
        }
        finally
        {
            _ocupado = false;
        }
    }
}
