@page "/"
@inherits PaginaProtegida

@if (!Autenticado)
{
    <p class="vazio">Carregando...</p>
}
else if (_erro is not null)
{
    <p class="aviso erro" role="alert">@_erro</p>
}
else if (_perfil is null)
{
    <p class="vazio">Carregando...</p>
}
else
{
    <section class="hero">
        <p>Olá, @_perfil.Nome</p>
        <h1>@_perfil.Cargo</h1>
        <div class="fichas">
            <span class="ficha">Nível de acesso @_perfil.Nivel</span>
            <span class="ficha">CPF @_perfil.CpfMascarado</span>
            @if (_perfil.Admin)
            {
                <span class="ficha">Administrador</span>
            }
        </div>
    </section>

    <div class="secao-titulo">
        <h2>Propriedades rurais com agrotóxicos proibidos</h2>
        <span class="rotulo">Níveis 2 e 3 pedem o rosto a cada consulta</span>
    </div>
    <div class="grade-niveis">
        @foreach (var nivel in Niveis)
        {
            var liberado = _perfil.Nivel >= nivel.Numero;
            <article class="nivel-cartao n@(nivel.Numero) @(liberado ? "liberado" : "bloqueado")">
                <span class="numero">@nivel.Numero</span>
                <h3>@nivel.Titulo</h3>
                <p>@nivel.Descricao</p>
                <ul>
                    @foreach (var campo in nivel.Campos)
                    {
                        <li>@campo</li>
                    }
                </ul>
                <span class="estado">@(liberado ? (nivel.Numero == 1 ? "Aberto para você" : "Aberto para você, com o rosto") : "Acima do seu nível de acesso")</span>
                <a class="botao @(liberado ? "" : "fantasma")" href="@($"dados/{nivel.Numero}")">@(liberado ? "Abrir a tabela" : "Tentar abrir")</a>
            </article>
        }
    </div>
    <p class="rotulo">Tentar abrir um nível acima do seu fica registrado no relatório de segurança.</p>
}

@code {
    private static readonly (int Numero, string Titulo, string Descricao, string[] Campos)[] Niveis =
    [
        (1, "Todos os servidores", "Panorama público da base.", ["Município e estado", "Produto proibido", "Ano"]),
        (2, "Diretores de divisão", "Detalhe operacional de cada propriedade.", ["Tudo do nível 1", "Propriedade", "Litros aplicados e hectares"]),
        (3, "Somente o ministro", "Dados sigilosos da fiscalização.", ["Tudo do nível 2", "Proprietário e documento", "Multa e andamento do processo"]),
    ];

    private PerfilResponse? _perfil;
    private string? _erro;

    protected override async Task CarregarAsync()
    {
        var r = await Api.PerfilAsync();
        if (r.Ok)
        {
            _perfil = r.Valor;
        }
        else
        {
            _erro = r.Erro!.Mensagem;
        }
    }
}
