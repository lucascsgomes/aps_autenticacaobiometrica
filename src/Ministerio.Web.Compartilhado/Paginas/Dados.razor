@page "/dados/{Nivel:int}"
@inherits PaginaProtegida
@implements IDisposable

<h1>Informações de nível @Nivel</h1>

@if (!Autenticado)
{
    <p class="vazio">Carregando...</p>
}
else if (Nivel is < 1 or > 3)
{
    <p class="aviso erro" role="alert">Nível inexistente. Use 1, 2 ou 3.</p>
}
else if (_dados is null)
{
    @if (Nivel > 1)
    {
        <section class="cartao estreito">
            <p>Este nível só abre com o seu rosto, confirmado agora. Olhe para a câmera, com o rosto inteiro no quadro e boa luz.</p>
            <Camera @ref="_camera" Verificando="_ocupado" OnPronta="() => _cameraPronta = true" />
            @if (_erro is not null)
            {
                <p class="aviso erro" role="alert">@_erro</p>
            }
            <div class="acoes">
                <button type="button" disabled="@(_ocupado || !_cameraPronta)" @onclick="AbrirAsync">@(_ocupado ? "Verificando..." : "Confirmar o rosto e abrir")</button>
                <a class="botao secundario" href="">Voltar</a>
            </div>
        </section>
    }
    else if (_erro is not null)
    {
        <p class="aviso erro" role="alert">@_erro</p>
    }
    else
    {
        <p class="vazio">Carregando...</p>
    }
}
else
{
    var itens = Filtrados().ToList();
    <div class="resumo">
        <div class="c-agua"><strong>@_dados.Itens.Count</strong><span>propriedades na base</span></div>
        <div class="c-folha"><strong>@_dados.Itens.Select(p => p.Uf).Distinct().Count()</strong><span>estados</span></div>
        <div class="c-folha"><strong>@_dados.Itens.Select(p => p.Agrotoxico).Distinct().Count()</strong><span>produtos proibidos</span></div>
        @if (Nivel >= 2)
        {
            <div class="c-terra"><strong>@_dados.Itens.Sum(p => p.QuantidadeLitros ?? 0).ToString("N0", Invariante) L</strong><span>aplicados</span></div>
            <div class="c-terra"><strong>@_dados.Itens.Sum(p => p.AreaHectares ?? 0).ToString("N0", Invariante) ha</strong><span>de área</span></div>
        }
        @if (Nivel >= 3)
        {
            <div class="c-erro"><strong>@Formato.Reais(_dados.Itens.Sum(p => p.MultaCentavos ?? 0))</strong><span>em multas</span></div>
        }
    </div>

    <div class="filtros">
        <label>Buscar
            <input @bind="_busca" @bind:event="oninput" placeholder="@Dica" autocomplete="off" />
        </label>
        <label>Estado
            <select @bind="_uf">
                <option value="">Todos</option>
                @foreach (var uf in _dados.Itens.Select(p => p.Uf).Distinct().Order())
                {
                    <option value="@uf">@uf</option>
                }
            </select>
        </label>
    </div>

    <div class="painel-tabela">
        <div class="tabela">
            <table>
                <thead>
                    <tr>
                        <th>Município</th>
                        <th>UF</th>
                        <th>Produto</th>
                        <th>Ano</th>
                        @if (Nivel >= 2)
                        {
                            <th class="restrito">Propriedade</th>
                            <th class="restrito num">Litros</th>
                            <th class="restrito num">Hectares</th>
                        }
                        @if (Nivel >= 3)
                        {
                            <th class="restrito">Proprietário</th>
                            <th class="restrito">Documento</th>
                            <th class="restrito num">Multa</th>
                            <th class="restrito">Situação</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in itens)
                    {
                        <tr>
                            <td>@p.Municipio</td>
                            <td><span class="selo neutro">@p.Uf</span></td>
                            <td>@p.Agrotoxico</td>
                            <td>@p.Ano</td>
                            @if (Nivel >= 2)
                            {
                                <td>@p.Propriedade</td>
                                <td class="num">@p.QuantidadeLitros?.ToString("N2", Invariante)</td>
                                <td class="num">@p.AreaHectares?.ToString("N2", Invariante)</td>
                            }
                            @if (Nivel >= 3)
                            {
                                <td>@p.Proprietario</td>
                                <td>@p.Documento</td>
                                <td class="num">@(p.MultaCentavos is { } m ? Formato.Reais(m) : "")</td>
                                <td><span class="selo @ClasseDaSituacao(p.Situacao)">@p.Situacao</span></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="rodape-tabela">
            @(itens.Count == _dados.Itens.Count ? $"{itens.Count} registros." : $"{itens.Count} de {_dados.Itens.Count} registros.")
            Colunas em marrom são restritas a este nível. As informações somem da tela quando você sair desta página.
        </div>
    </div>
    @if (itens.Count == 0)
    {
        <p class="vazio">Nenhum registro com esse filtro.</p>
    }
    <div class="acoes">
        <a class="botao secundario" href="">Fechar e voltar</a>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Invariante = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter]
    public int Nivel { get; set; }

    private DadosResponse? _dados;
    private string Dica => "Município, produto" + (Nivel >= 2 ? ", propriedade" : "") + (Nivel >= 3 ? ", proprietário" : "");
    private string _busca = "";
    private string _uf = "";

    private IEnumerable<PropriedadeDto> Filtrados()
    {
        var b = _busca.Trim();
        return _dados!.Itens.Where(p =>
            (_uf == "" || p.Uf == _uf) &&
            (b == "" || new[] { p.Municipio, p.Agrotoxico, p.Propriedade, p.Proprietario }
                .Any(t => t?.Contains(b, StringComparison.CurrentCultureIgnoreCase) == true)));
    }

    private static string ClasseDaSituacao(string? situacao) => situacao switch
    {
        "Multa paga" => "",
        "Em recurso" => "alerta",
        "Processo no MPF" => "erro",
        "Autuado" => "erro",
        _ => "neutro",
    };

    private string? _erro;
    private bool _ocupado;
    private bool _cameraPronta;
    private Camera? _camera;

    protected override async Task CarregarAsync()
    {
        if (Nivel == 1)
        {
            Aplicar(await Api.DadosDoNivel1Async());
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Trocar de nível pela barra de endereço descarta o que estava na tela.
        if (_dados is not null && _dados.Nivel != Nivel)
        {
            _dados = null;
            _erro = null;
            if (Autenticado)
            {
                await CarregarAsync();
            }
        }
    }

    private async Task AbrirAsync()
    {
        _ocupado = true;
        _erro = null;
        try
        {
            var foto = await _camera!.CapturarAsync();
            if (foto is null)
            {
                _erro = "A câmera ainda não está pronta.";
                return;
            }

            Aplicar(await Api.DadosRestritosAsync(Nivel, foto));
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void Aplicar(Resposta<DadosResponse> r)
    {
        if (r.Ok)
        {
            _dados = r.Valor;
        }
        else
        {
            _erro = r.Erro!.Mensagem;
        }
    }

    public void Dispose() => _dados = null;
}
