@page "/transferir"
@inherits PaginaProtegida

<section class="cartao estreito">
    <h1>Transferir</h1>

    @if (!Autenticado)
    {
        <p class="vazio">Carregando...</p>
    }
    else if (_comprovante is not null)
    {
        <p class="aviso ok" role="status">Transferência concluída.</p>
        <dl class="dados">
            <dt>Valor</dt><dd>@Formato.Reais(_comprovante.ValorCentavos)</dd>
            <dt>Para</dt><dd>@_comprovante.Destino.Nome</dd>
            <dt>Saldo depois</dt><dd>@Formato.Reais(_comprovante.SaldoAposCentavos)</dd>
            <dt>Confirmada com</dt><dd>@(_comprovante.MetodoConfirmacao == "FACE" ? "o rosto" : "a senha")</dd>
            <dt>Quando</dt><dd>@Formato.DataHora(_comprovante.ConcluidaEm)</dd>
            <dt>Código</dt><dd class="codigo">@_comprovante.E2eId</dd>
        </dl>
        <div class="acoes">
            <a class="botao" href="">Voltar ao início</a>
            <button type="button" class="secundario" @onclick="Recomecar">Nova transferência</button>
        </div>
    }
    else if (_intencao is null)
    {
        <form @onsubmit="ContinuarAsync" @onsubmit:preventDefault>
            <label>Chave do destinatário (CPF, e-mail, celular ou chave aleatória)
                <input @bind="_chave" autocomplete="off" />
            </label>
            <label>Valor (R$)
                <input @bind="_valor" inputmode="decimal" placeholder="0,00" />
            </label>
            <label>Descrição (opcional)
                <input @bind="_descricao" maxlength="140" />
            </label>
            @if (_erro is not null)
            {
                <p class="aviso erro" role="alert">@_erro</p>
            }
            <div class="acoes">
                <button type="submit" disabled="@_ocupado">Continuar</button>
            </div>
        </form>
    }
    else
    {
        <dl class="dados">
            <dt>Valor</dt><dd>@Formato.Reais(_intencao.Resumo.ValorCentavos)</dd>
            <dt>Para</dt><dd>@_intencao.Resumo.Destino.NomeMascarado</dd>
            <dt>Chave</dt><dd>@_intencao.Resumo.Destino.ChaveMascarada</dd>
            <dt>Saldo depois</dt><dd>@Formato.Reais(_intencao.Resumo.SaldoAposCentavos)</dd>
        </dl>

        @if (_modo == Modo.Escolha)
        {
            <p>Confirme a transferência. Ela vale por alguns minutos.</p>
            <div class="acoes">
                @if (_intencao.Metodos.Contains("FACE"))
                {
                    <button type="button" disabled="@_ocupado" @onclick="UsarRostoAsync">Confirmar com o rosto</button>
                }
                <button type="button" class="@(_intencao.Metodos.Contains("FACE") ? "secundario" : "")" disabled="@_ocupado" @onclick="() => _modo = Modo.Senha">Confirmar com a senha</button>
                <button type="button" class="link" @onclick="Recomecar">Cancelar</button>
            </div>
        }
        else if (_modo == Modo.Senha)
        {
            <form @onsubmit="ConfirmarComSenhaAsync" @onsubmit:preventDefault>
                <label>Senha da conta
                    <input @bind="_senha" type="password" autocomplete="current-password" />
                </label>
                <div class="acoes">
                    <button type="submit" disabled="@_ocupado">@(_ocupado ? "Confirmando..." : "Confirmar")</button>
                    <button type="button" class="secundario" disabled="@_ocupado" @onclick="Voltar">Voltar</button>
                </div>
            </form>
        }
        else
        {
            <p>Olhe para a câmera, com o rosto inteiro no quadro e boa luz.</p>
            <Camera @ref="_camera" OnPronta="() => _cameraPronta = true" />
            <div class="acoes">
                <button type="button" disabled="@(_ocupado || !_cameraPronta)" @onclick="ConfirmarComRostoAsync">@(_ocupado ? "Verificando..." : "Confirmar")</button>
                <button type="button" class="secundario" disabled="@_ocupado" @onclick="Voltar">Voltar</button>
            </div>
        }

        @if (_erro is not null)
        {
            <p class="aviso erro" role="alert">@_erro</p>
        }
    }
</section>

@code {
    private enum Modo { Escolha, Senha, Rosto }

    // Nesses casos a transferência continua pendente e dá para tentar de novo; nos outros ela foi cancelada ou venceu.
    private static readonly string[] ErrosQueMantemATransferencia = ["NO_FACE_DETECTED", "MULTIPLE_FACES", "FACE_SERVICE_UNAVAILABLE", "INVALID_IMAGE", "IMAGE_TOO_LARGE", "NETWORK"];

    private string _chave = "";
    private string _valor = "";
    private string _descricao = "";
    private string _senha = "";
    private string? _erro;
    private bool _ocupado;
    private bool _cameraPronta;
    private Modo _modo;
    private Guid? _desafio;
    private Camera? _camera;
    private IntencaoResponse? _intencao;
    private ComprovanteResponse? _comprovante;

    private async Task ContinuarAsync()
    {
        if (string.IsNullOrWhiteSpace(_chave))
        {
            _erro = "Informe a chave do destinatário.";
            return;
        }

        if (!Formato.TentarCentavos(_valor, out var centavos))
        {
            _erro = "Informe um valor válido, como 25,50.";
            return;
        }

        await ExecutarAsync(async () =>
        {
            var r = await Api.CriarIntencaoAsync(_chave.Trim(), centavos, string.IsNullOrWhiteSpace(_descricao) ? null : _descricao.Trim());
            if (r.Ok)
            {
                _intencao = r.Valor;
                _modo = Modo.Escolha;
            }
            else
            {
                _erro = r.Erro!.Mensagem;
            }
        });
    }

    private async Task ConfirmarComSenhaAsync()
    {
        if (string.IsNullOrEmpty(_senha))
        {
            _erro = "Informe a senha.";
            return;
        }

        await ExecutarAsync(async () =>
        {
            var r = await Api.ConfirmarComSenhaAsync(_intencao!.TransferenciaId, _senha);
            _senha = "";
            Tratar(r);
        });
    }

    private async Task UsarRostoAsync() =>
        await ExecutarAsync(async () =>
        {
            var r = await Api.DesafioDeTransferenciaAsync(_intencao!.TransferenciaId);
            if (r.Ok)
            {
                _desafio = r.Valor!.DesafioId;
                _cameraPronta = false;
                _modo = Modo.Rosto;
            }
            else
            {
                _erro = r.Erro!.Mensagem;
            }
        });

    private async Task ConfirmarComRostoAsync() =>
        await ExecutarAsync(async () =>
        {
            var foto = await _camera!.CapturarAsync();
            if (foto is null)
            {
                _erro = "A câmera ainda não está pronta.";
                return;
            }

            Tratar(await Api.ConfirmarComRostoAsync(_intencao!.TransferenciaId, _desafio!.Value, foto));
        });

    private void Tratar(Resposta<ComprovanteResponse> r)
    {
        if (r.Ok)
        {
            _comprovante = r.Valor;
            return;
        }

        _erro = r.Erro!.Mensagem;
        if (r.Erro.Code is null || !ErrosQueMantemATransferencia.Contains(r.Erro.Code))
        {
            // Senha ou rosto errados cancelam a transferência: volta ao começo, com o motivo na tela.
            var motivo = _erro;
            Recomecar();
            _erro = motivo;
        }
    }

    private void Voltar()
    {
        _modo = Modo.Escolha;
        _erro = null;
    }

    private void Recomecar()
    {
        _intencao = null;
        _comprovante = null;
        _desafio = null;
        _modo = Modo.Escolha;
        _senha = "";
        _erro = null;
    }

    private async Task ExecutarAsync(Func<Task> acao)
    {
        _ocupado = true;
        _erro = null;
        try
        {
            await acao();
        }
        finally
        {
            _ocupado = false;
        }
    }
}
