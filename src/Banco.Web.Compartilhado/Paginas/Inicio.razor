@page "/"
@inherits PaginaProtegida

@if (!Autenticado)
{
    <p class="vazio">Carregando...</p>
}
else if (_erro is not null)
{
    <p class="aviso erro" role="alert">@_erro</p>
}
else if (_conta is null)
{
    <p class="vazio">Carregando...</p>
}
else
{
    <section class="cartao saldo">
        <p class="rotulo">Olá, @_conta.Titular.Nome</p>
        <p class="valor">@Formato.Reais(_conta.SaldoCentavos)</p>
        <p class="rotulo">Agência @_conta.Agencia · Conta @_conta.Numero</p>
    </section>

    <section class="cartao">
        <h2>Suas chaves</h2>
        <ul class="lista">
            @foreach (var chave in _conta.Chaves)
            {
                <li><span>@chave.Tipo</span> <span>@chave.ValorMascarado</span></li>
            }
        </ul>
    </section>

    <section class="cartao">
        <h2>Extrato</h2>
        @if (_extrato.Count == 0)
        {
            <p class="vazio">Nenhuma movimentação ainda.</p>
        }
        else
        {
            <ul class="lista">
                @foreach (var item in _extrato)
                {
                    <li>
                        <div>
                            <strong>@item.Contraparte.Nome</strong>
                            <small>@(item.Descricao ?? (item.Tipo == "D" ? "Enviada" : "Recebida")) · @Formato.DataHora(item.CriadoEm)</small>
                        </div>
                        <span class="@(item.Tipo == "D" ? "saida" : "entrada")">@(item.Tipo == "D" ? "-" : "+") @Formato.Reais(item.ValorCentavos)</span>
                    </li>
                }
            </ul>
            @if (_proximo is not null)
            {
                <button type="button" class="secundario" disabled="@_carregandoMais" @onclick="MaisAsync">Ver mais</button>
            }
        }
    </section>
}

@code {
    private ContaMeResponse? _conta;
    private readonly List<ExtratoItemDto> _extrato = [];
    private string? _proximo;
    private string? _erro;
    private bool _carregandoMais;

    protected override async Task CarregarAsync()
    {
        var conta = await Api.ContaAsync();
        if (!conta.Ok)
        {
            _erro = conta.Erro!.Mensagem;
            return;
        }

        _conta = conta.Valor;
        await MaisAsync();
    }

    private async Task MaisAsync()
    {
        _carregandoMais = true;
        try
        {
            var r = await Api.ExtratoAsync(_proximo);
            if (r.Ok)
            {
                _extrato.AddRange(r.Valor!.Data);
                _proximo = r.Valor.HasMore ? r.Valor.NextCursor : null;
            }
            else
            {
                _erro = r.Erro!.Mensagem;
            }
        }
        finally
        {
            _carregandoMais = false;
        }
    }
}
