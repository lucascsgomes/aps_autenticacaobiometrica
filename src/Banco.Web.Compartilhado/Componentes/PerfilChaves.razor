@inject ApiBanco Api

<section class="cartao">
    <h2>Chaves de transferência</h2>

    <ul class="lista">
        @foreach (var chave in Chaves)
        {
            <li>
                <div><strong>@chave.Tipo</strong> <small>@chave.ValorMascarado</small></div>
                @if (chave.Tipo != "CPF")
                {
                    <button type="button" class="link" disabled="@_ocupado" @onclick="() => ApagarAsync(chave.Id)">Apagar</button>
                }
            </li>
        }
    </ul>

    @if (!_confirmando)
    {
        <form @onsubmit="Continuar" @onsubmit:preventDefault>
            <label>Nova chave
                <select @bind="_tipo">
                    <option value="EMAIL">E-mail</option>
                    <option value="CELULAR">Celular</option>
                    <option value="ALEATORIA">Aleatória</option>
                </select>
            </label>
            @if (_tipo != "ALEATORIA")
            {
                <label>@(_tipo == "EMAIL" ? "E-mail" : "Celular (+5511999999999)")
                    <input @bind="_valor" autocomplete="off" />
                </label>
            }
            @if (_erro is not null)
            {
                <p class="aviso erro" role="alert">@_erro</p>
            }
            <div class="acoes">
                <button type="submit" disabled="@_ocupado">Adicionar chave</button>
            </div>
        </form>
    }
    else
    {
        <Confirmacao Texto="Criar uma chave exige confirmação com a senha ou com o rosto."
                     PermiteRosto="TemRosto"
                     Ocupado="_ocupado"
                     Erro="@_erro"
                     OnConfirmar="CriarAsync"
                     OnCancelar="Cancelar" />
    }
</section>

@code {
    private string _tipo = "EMAIL";
    private string _valor = "";
    private bool _confirmando;
    private bool _ocupado;
    private string? _erro;

    [Parameter]
    public IReadOnlyList<ChaveDto> Chaves { get; set; } = [];

    [Parameter]
    public bool TemRosto { get; set; }

    [Parameter]
    public EventCallback OnMudou { get; set; }

    private NovaChaveRequest Pedido => new(_tipo, _tipo == "ALEATORIA" ? null : _valor.Trim());

    private void Continuar()
    {
        if (_tipo != "ALEATORIA" && string.IsNullOrWhiteSpace(_valor))
        {
            _erro = "Informe o valor da chave.";
            return;
        }

        _erro = null;
        _confirmando = true;
    }

    private void Cancelar()
    {
        _confirmando = false;
        _erro = null;
    }

    private async Task CriarAsync(Credencial credencial)
    {
        _ocupado = true;
        _erro = null;
        try
        {
            var pedido = Pedido;
            var r = await Api.AcaoSensivelAsync<ChaveCriadaResponse>(HttpMethod.Post, "/v1/contas/me/chaves", "NOVA_CHAVE", pedido, credencial, pedido);
            if (r.Ok)
            {
                _valor = "";
                _confirmando = false;
                await OnMudou.InvokeAsync();
            }
            else
            {
                _erro = r.Erro!.Mensagem;
            }
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task ApagarAsync(Guid id)
    {
        _ocupado = true;
        _erro = null;
        try
        {
            var r = await Api.ApagarChaveAsync(id);
            if (r.Ok)
            {
                await OnMudou.InvokeAsync();
            }
            else
            {
                _erro = r.Erro!.Mensagem;
            }
        }
        finally
        {
            _ocupado = false;
        }
    }
}
