@inject ApiBanco Api

<section class="cartao">
    <h2>Limites de transferência</h2>

    @if (_limites is null)
    {
        <p class="vazio">@(_erro ?? "Carregando...")</p>
    }
    else
    {
        <p class="rotulo">Hoje você usou @Formato.Reais(_limites.UsadoNaJanelaAtualCentavos) na janela @(_limites.JanelaAtual == "NOTURNA" ? "noturna" : "diurna"). A noite vai das @_limites.InicioNoturno às @_limites.FimNoturno.</p>

        @if (!_confirmando)
        {
            <form @onsubmit="SalvarAsync" @onsubmit:preventDefault>
                <label>Limite diurno (R$)
                    <input @bind="_diurno" inputmode="decimal" />
                </label>
                <label>Limite noturno (R$)
                    <input @bind="_noturno" inputmode="decimal" />
                </label>
                @if (_erro is not null)
                {
                    <p class="aviso erro" role="alert">@_erro</p>
                }
                @if (_aviso is not null)
                {
                    <p class="aviso ok" role="status">@_aviso</p>
                }
                <div class="acoes">
                    <button type="submit" disabled="@_ocupado">Salvar</button>
                </div>
            </form>
        }
        else
        {
            <Confirmacao Texto="Aumentar um limite exige confirmação com a senha ou com o rosto."
                         PermiteRosto="TemRosto"
                         Ocupado="_ocupado"
                         Erro="@_erro"
                         OnConfirmar="AumentarAsync"
                         OnCancelar="Cancelar" />
        }
    }
</section>

@code {
    private LimitesResponse? _limites;
    private LimitesRequest? _pedido;
    private string _diurno = "";
    private string _noturno = "";
    private bool _confirmando;
    private bool _ocupado;
    private string? _erro;
    private string? _aviso;

    [Parameter]
    public bool TemRosto { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.LimitesAsync();
        if (r.Ok)
        {
            Mostrar(r.Valor!);
        }
        else
        {
            _erro = r.Erro!.Mensagem;
        }
    }

    private void Mostrar(LimitesResponse limites)
    {
        _limites = limites;
        _diurno = (limites.LimiteDiurnoCentavos / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture).Replace('.', ',');
        _noturno = (limites.LimiteNoturnoCentavos / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture).Replace('.', ',');
    }

    private async Task SalvarAsync()
    {
        _erro = null;
        _aviso = null;
        if (!Formato.TentarCentavos(_diurno, out var diurno) || !Formato.TentarCentavos(_noturno, out var noturno))
        {
            _erro = "Informe os dois limites em reais, como 1000,00.";
            return;
        }

        if (noturno > diurno)
        {
            _erro = "O limite noturno não pode passar do diurno.";
            return;
        }

        // Só manda o que mudou: o servidor compara cada campo com o valor atual para saber se é aumento.
        _pedido = new LimitesRequest(
            diurno == _limites!.LimiteDiurnoCentavos ? null : diurno,
            noturno == _limites.LimiteNoturnoCentavos ? null : noturno,
            null);
        if (_pedido.LimiteDiurnoCentavos is null && _pedido.LimiteNoturnoCentavos is null)
        {
            _aviso = "Nada mudou.";
            return;
        }

        var aumenta = diurno > _limites.LimiteDiurnoCentavos || noturno > _limites.LimiteNoturnoCentavos;
        if (aumenta)
        {
            _confirmando = true;
            return;
        }

        _ocupado = true;
        try
        {
            Tratar(await Api.ReduzirLimitesAsync(_pedido));
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task AumentarAsync(Credencial credencial)
    {
        _ocupado = true;
        _erro = null;
        try
        {
            Tratar(await Api.AcaoSensivelAsync<LimitesResponse>(HttpMethod.Put, "/v1/contas/me/limites", "ALTERAR_LIMITE", _pedido, credencial, _pedido));
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void Tratar(Resposta<LimitesResponse> r)
    {
        if (r.Ok)
        {
            Mostrar(r.Valor!);
            _confirmando = false;
            _aviso = "Limites atualizados.";
        }
        else
        {
            _erro = r.Erro!.Mensagem;
        }
    }

    private void Cancelar()
    {
        _confirmando = false;
        _erro = null;
    }
}
